# llmwiki provider configuration for a company-hosted Qwen endpoint.
# Copy to `.env` and fill in the real values — llmwiki reads .env from the
# project directory automatically.

# --- Provider selection -----------------------------------------------------
# `openai` = any OpenAI-compatible server (vLLM, SGLang, TGI, company gateway).
LLMWIKI_PROVIDER=openai

# --- Chat / tool-calling endpoint -------------------------------------------
# Include /v1. The model MUST support tool calls: llmwiki's concept extraction
# uses a tool call and fails on the first request if the model can't return
# tool arguments. Qwen3/Qwen2.5-Instruct deployments generally do.
OPENAI_BASE_URL=https://your-company-llm-gateway.example.com/v1
OPENAI_API_KEY=sk-your-company-key
LLMWIKI_MODEL=qwen3-32b-instruct        # ← set to your deployment's exact model name

# --- Embeddings (semantic search) --------------------------------------------
# If the same endpoint serves an embedding model, just name it:
LLMWIKI_EMBEDDING_MODEL=text-embedding-v3  # ← your embedding model name

# If embeddings live on a DIFFERENT endpoint, split them out:
# OPENAI_EMBEDDINGS_BASE_URL=https://your-embeddings-endpoint/v1
# OPENAI_EMBEDDINGS_API_KEY=sk-different-key

# If NO embedding endpoint exists, delete LLMWIKI_EMBEDDING_MODEL above:
# `llmwiki query` then falls back to lexical ranking — everything still works.

# --- Tuning ------------------------------------------------------------------
# Slow generations: raise the per-request timeout (default is 10 minutes).
# LLMWIKI_REQUEST_TIMEOUT_MS=1800000

# Parallel LLM calls during compile (default 4). Match your deployment's capacity.
# LLMWIKI_COMPILE_CONCURRENCY=4

# Per-concept source budget for page generation in chars (default 200000).
# Lower it if your Qwen context window is small (e.g. 32k tokens ≈ 100000 chars).
# LLMWIKI_PROMPT_BUDGET_CHARS=100000
